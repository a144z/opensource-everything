{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FitCheck",
  "version": "0.0.1",
  "identifier": "io.apexus.fitcheck",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev -w @apexus/sketchup-app",
    "beforeBuildCommand": "npm run build -w @apexus/sketchup-app"
  },
  "app": {
    "windows": [
      {
        "title": "FitCheck",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Dimensional push-pull modelling with a built-in fit check",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
